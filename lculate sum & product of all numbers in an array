#include <iostream>
using namespace std;
void sumproduct(int arr[],int n){
    int sum=0;
    int product =1;//multiplication is 1
    
    for(int i=0;i<n;i++){
        sum = sum + arr[i];
        product = product*arr[i];
    }
    cout<<"sum="<<sum<<endl;
     cout<<"product="<<product<<endl;
}

int main() {
    int n;
    cout<<"enter size of array:";
    cin>>n;
    int arr[n];
     cout<<"enter  elements:";
     for(int i=0; i<n; i++){
          cin>>arr[i];
     
     }
     sumproduct(arr, n);
   

    return 0;
}
