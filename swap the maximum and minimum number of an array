#include <iostream>
using namespace std;

void swapMaxMin(int arr[], int n)
{
    int maxIndex = 0, minIndex = 0;

    for (int i = 1; i < n; i++)
    {
        if (arr[i] > arr[maxIndex])
            maxIndex = i;

        if (arr[i] < arr[minIndex])
            minIndex = i;
    }

    int temp = arr[maxIndex];
    arr[maxIndex] = arr[minIndex];
    arr[minIndex] = temp;

    cout << "Array after swapping:\n";

    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";
}

int main()
{
    int n;
    cout << "Enter size: ";
    cin >> n;

    int arr[n];

    cout << "Enter elements: ";
    for (int i = 0; i < n; i++)
        cin >> arr[i];

    swapMaxMin(arr, n);

    return 0;
}
